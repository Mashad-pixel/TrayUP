FLASK_CONFIG=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///canteen.db

RATELIMIT_STORAGE_URI=memory://

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ORDER_PAYMENT_EXPIRY_MINUTES=10
COLLECTION_TOKEN_EXPIRY_MINUTES=60

# Canteen clock offset from UTC in minutes (330 = India, UTC+05:30). Used for report days.
CANTEEN_UTC_OFFSET_MINUTES=330

# --- Live QR + GPS presence verification -------------------------------------------------
# Get these from a surveyed point at the canteen entrance (for example, a phone at the door).
# Never guess them. Required in production. Without them, ordering stays unavailable.
CANTEEN_LATITUDE=
CANTEEN_LONGITUDE=

# Students must be within this distance of the canteen, and their GPS must be at least this precise.
PRESENCE_RADIUS_METERS=100
PRESENCE_MAX_ACCURACY_METERS=75

# Each live QR code expires after this many seconds. The canteen screen replaces it on this cycle.
PRESENCE_TOKEN_TTL_SECONDS=10
# A verified student has this long to place one order.
PRESENCE_SESSION_TTL_SECONDS=180
# Reject GPS readings older than this (prevents replaying an old location reading).
PRESENCE_GPS_MAX_AGE_SECONDS=60
# Verification records (audit trail) are deleted after this many days by `flask prune-presence`.
PRESENCE_RETENTION_DAYS=7

# Public origin that students' phones use to open the verify page. Required in production (https).
# Development example for testing on a phone on the same Wi-Fi: http://192.168.1.20:5000
PUBLIC_BASE_URL=
