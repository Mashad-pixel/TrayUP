FLASK_CONFIG=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///canteen.db

RATELIMIT_STORAGE_URI=memory://

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Realtime Database (server-side Admin SDK; never commit the service-account JSON)
FIREBASE_ENABLED=true
FIREBASE_DATABASE_URL=https://trayup-36abb-default-rtdb.asia-southeast1.firebasedatabase.app/
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

ORDER_PAYMENT_EXPIRY_MINUTES=10
COLLECTION_TOKEN_EXPIRY_MINUTES=60

# Canteen clock offset from UTC in minutes (330 = India, UTC+05:30). Used for report days.
CANTEEN_UTC_OFFSET_MINUTES=330
