FLASK_CONFIG=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=sqlite:///canteen.db

# Number of trusted reverse proxies (0 locally; set based on known deployment topology).
TRUSTED_PROXY_COUNT=0
RATELIMIT_STORAGE_URI=memory://

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Firebase Admin SDK; never commit the service-account JSON file.
FIREBASE_ENABLED=false
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

ORDER_PAYMENT_EXPIRY_MINUTES=10
COLLECTION_TOKEN_EXPIRY_MINUTES=60
CANTEEN_UTC_OFFSET_MINUTES=330
